// ------------------------------------------------------
// MILENIA SAAS RESTAURANT PLATFORM - PRISMA SCHEMA
// Multi-tenant architecture for Colombian Restaurant SaaS
// ------------------------------------------------------

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------- ENUMS ----------------

enum Role {
  SUPERADMIN      // Milenia SaaS Master Admin
  OWNER           // Restaurant Franchise Owner
  MANAGER         // Restaurant Administrator
  MESERO          // Floor Waiter / Order Taking
  COCINA          // Kitchen Display System (KDS)
  CAJERO          // Cashier / Billing
}

enum SubscriptionPlan {
  BASIC           // $149.000 COP / mes
  PRO             // $289.000 COP / mes
  ENTERPRISE      // $499.000 COP / mes
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
}

enum OrderType {
  DINE_IN         // Mesa en salón
  TAKEAWAY        // Para llevar
  DELIVERY        // Domicilio
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  SERVED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH            // Efectivo
  CARD            // Datafono / Tarjeta
  NEQUI           // Nequi QR Colombia
  DAVIPLATA       // Daviplata QR Colombia
  PSE             // PSE Pagos Seguros en Línea
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
  CLEANING
}

// ---------------- MULTI-TENANT ENTITIES ----------------

// 1. TENANT / RESTAURANTE
model Restaurant {
  id              String             @id @default(uuid())
  slug            String             @unique // e.g. "camilo", "milenia-bogota"
  name            String             // e.g. "Restaurante Parrilla Camilo"
  nit             String             // NIT / RUT DIAN Colombia e.g. "901.884.231-9"
  city            String             // e.g. "Medellín, Antioquia"
  address         String
  phone           String
  email           String
  
  // Dynamic Branding
  logoUrl         String?
  bannerUrl       String?
  primaryColor    String             @default("#ea580c")
  accentColor     String             @default("#f59e0b")
  currency        String             @default("COP")
  dianResolution  String?            // "Resolución DIAN No. 187640..."
  tipPercentage   Float              @default(10.0) // 10% propina voluntaria
  taxRate         Float              @default(0.08) // 8% Impoconsumo Colombia
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Tenant Relationships (Partitioned by restaurantId)
  subscription    Subscription?
  employees       Employee[]
  categories      Category[]
  dishes          Dish[]
  tables          Table[]
  zones           Zone[]
  orders          Order[]
  customers       Customer[]
  reservations    Reservation[]
  inventories     InventoryItem[]

  @@index([slug])
}

// 2. SUBSCRIPTION (SaaS Master Billing)
model Subscription {
  id              String             @id @default(uuid())
  restaurantId    String             @unique
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  plan            SubscriptionPlan   @default(PRO)
  status          SubscriptionStatus @default(ACTIVE)
  mrrCop          Decimal            @db.Decimal(12, 2) // e.g. 289000.00 COP
  currentPeriodEnd DateTime
  maxTables       Int                @default(20)
  maxEmployees    Int                @default(10)
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// 3. EMPLOYEES (Aislados por Restaurante)
model Employee {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String
  email           String
  phone           String?
  pinCode         String             // 4-digit POS access code
  role            Role               @default(MESERO)
  avatar          String?
  isActive        Boolean            @default(true)
  
  ordersTaken     Order[]            @relation("EmployeeOrders")
  assignedTables  Table[]
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([restaurantId, email])
  @@index([restaurantId, role])
}

// 4. CATEGORIES
model Category {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String
  nameEn          String?
  icon            String             @default("Utensils")
  sortOrder       Int                @default(0)
  
  dishes          Dish[]
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([restaurantId])
}

// 5. DISHES / PLATOS (Catálogo Aislado)
model Dish {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  categoryId      String
  category        Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  name            String
  nameEn          String?
  description     String
  priceCop        Decimal            @db.Decimal(12, 2) // e.g. 48000.00 COP
  originalPrice   Decimal?           @db.Decimal(12, 2)
  image           String
  prepTimeMinutes Int                @default(15)
  isAvailable     Boolean            @default(true)
  isChefSpecial   Boolean            @default(false)
  dietaryTags     String[]           // ["sin_gluten", "vegano", "parrilla"]
  
  orderItems      OrderItem[]
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([restaurantId, categoryId])
}

// 6. MESAS Y ZONAS (Salón, Terraza, VIP)
model Zone {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String             // "Terraza Fogata", "Salón Principal"
  tables          Table[]

  @@index([restaurantId])
}

model Table {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  zoneId          String?
  zone            Zone?              @relation(fields: [zoneId], references: [id])
  
  number          String             // "Mesa 1", "Mesa 2"
  capacity        Int                @default(4)
  status          TableStatus        @default(AVAILABLE)
  
  assignedToId    String?
  assignedTo      Employee?          @relation(fields: [assignedToId], references: [id])
  
  orders          Order[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
}

// 7. CLIENTES (Aislados por Restaurante)
model Customer {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String
  email           String
  phone           String
  loyaltyPoints   Int                @default(0)
  
  orders          Order[]
  reservations    Reservation[]
  
  createdAt       DateTime           @default(now())

  @@unique([restaurantId, email])
  @@index([restaurantId])
}

// 8. PEDIDOS / COMANDAS
model Order {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  orderNumber     String             // "CAM-8012"
  orderType       OrderType          @default(DINE_IN)
  status          OrderStatus        @default(RECEIVED)
  
  tableId         String?
  table           Table?             @relation(fields: [tableId], references: [id])
  
  employeeId      String?
  employee        Employee?          @relation("EmployeeOrders", fields: [employeeId], references: [id])
  
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id])
  
  // Montos en Pesos Colombianos (COP)
  subtotal        Decimal            @db.Decimal(12, 2)
  taxAmount       Decimal            @db.Decimal(12, 2) // 8% Impoconsumo
  tipAmount       Decimal            @db.Decimal(12, 2) // 10% Propina voluntaria
  discountAmount  Decimal            @default(0) @db.Decimal(12, 2)
  total           Decimal            @db.Decimal(12, 2)
  
  paymentMethod   PaymentMethod      @default(CASH)
  paymentStatus   PaymentStatus      @default(PENDING)
  notes           String?
  
  items           OrderItem[]
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id              String             @id @default(uuid())
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  dishId          String
  dish            Dish               @relation(fields: [dishId], references: [id])
  
  quantity        Int                @default(1)
  unitPrice       Decimal            @db.Decimal(12, 2)
  totalPrice      Decimal            @db.Decimal(12, 2)
  specialNotes    String?
  optionsJson     Json?              // e.g. {"termino": "Medio", "acompanamiento": "Yuca"}

  @@index([orderId])
}

// 9. RESERVAS
model Reservation {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id])
  
  guestName       String
  guestPhone      String
  guestEmail      String
  guestsCount     Int
  date            DateTime
  timeSlot        String             // "20:00"
  status          String             @default("CONFIRMED")
  specialNotes    String?
  
  createdAt       DateTime           @default(now())

  @@index([restaurantId, date])
}

// 10. INVENTARIO (Stock por Restaurante)
model InventoryItem {
  id              String             @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name            String             // "Lomo Fino Angus", "Queso Costeño"
  quantity        Float
  unit            String             // "kg", "unidades", "litros"
  minAlertLevel   Float
  costPerUnitCop  Decimal            @db.Decimal(12, 2)

  @@index([restaurantId])
}
