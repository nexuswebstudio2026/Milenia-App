// -----------------------------------------------------------------------------
// MILENIA MULTI-TENANT SAAS RESTAURANT PLATFORM - PRISMA SCHEMA
// Architecture for Multi-Restaurant Tenant Isolation, Staff, POS & DIAN Fiscal
// -----------------------------------------------------------------------------

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum SubscriptionPlan {
  BASIC       // $149.000 COP / mes
  PRO         // $289.000 COP / mes
  ENTERPRISE  // $499.000 COP / mes
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
}

enum EmployeeRole {
  OWNER
  ADMINISTRADOR
  MESERO
  COCINA
  CAJERO
}

enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  NEQUI
  DAVIPLATA
  PSE
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
  CLEANING
}

// -----------------------------------------------------------------------------
// CORE MULTI-TENANT TABLES
// -----------------------------------------------------------------------------

// 1. TABLE: Restaurants (ID, Nombre, NIT, Plan de suscripción)
model Restaurant {
  id                  String             @id @default(uuid())
  slug                String             @unique // e.g. "camilo", "milenia-bogota"
  name                String             // e.g. "Parrilla & Fuego Camilo"
  nit                 String             // NIT DIAN e.g. "901.884.231-9"
  legalBusinessName   String?            // "Milenia Gastronomía Colombiana S.A.S."
  city                String             // "Medellín, Antioquia"
  address             String             // "Cra. 37 #8A-12, El Poblado"
  phone               String             // "+57 304-347-0984"
  email               String             // "contacto@parrillacamilo.co"
  
  // Subscription Plan
  subscriptionPlan    SubscriptionPlan   @default(PRO)
  subscriptionStatus  SubscriptionStatus @default(ACTIVE)
  mrrCop              Decimal            @default(289000.00) @db.Decimal(12, 2)
  renewsAt            DateTime?

  // Dynamic Visual Branding & Theming
  logoUrl             String?
  bannerUrl           String?
  primaryColor        String             @default("#ea580c")
  accentColor         String             @default("#f59e0b")
  themeStyle          String             @default("luxury") // "luxury" | "rustic" | "modern"
  currency            String             @default("COP")
  currencySymbol      String             @default("$")
  
  // Colombian Fiscal Settings
  dianResolution      String?            // "Resolución DIAN No. 18764032910 de 2025"
  tipPercentage       Float              @default(10.0) // 10% Propina voluntaria
  taxRateImpoconsumo  Float              @default(0.08) // 8% Impoconsumo Colombia
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Multi-Tenant Relations
  employees           Employee[]
  orders              Order[]
  menuCategories      MenuCategory[]
  menuItems           MenuItem[]
  tables              RestaurantTable[]
  inventoryItems      InventoryItem[]
  payrollRecords      PayrollRecord[]
  tableReservations   TableReservation[]

  @@map("Restaurants")
  @@index([slug])
}

// 2. TABLE: Employees (ID, RestaurantID, Cédula, Cargo)
model Employee {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name                String             // e.g. "Juan Camilo Vélez"
  documentId          String             // Cédula de Ciudadanía CC e.g. "1.020.456.789"
  cargo               String             // Cargo e.g. "Capitán de Meseros", "Chef Ejecutivo"
  role                EmployeeRole       @default(MESERO)
  email               String             // "juan.velez@parrillacamilo.co"
  phone               String?            // "+57 312 400 1122"
  avatar              String?
  pinCode             String             // "1111" para acceso rápido en POS
  
  // Payroll & Shifts
  shiftStatus         String             @default("active") // "active" | "break" | "off"
  baseSalaryCop       Decimal            @default(1850000.00) @db.Decimal(12, 2)
  hourlyRateCop       Decimal?           @db.Decimal(10, 2)
  currentClockInTime  DateTime?

  ordersTaken         Order[]            @relation("EmployeeOrders")
  assignedTables      RestaurantTable[]
  payrollRecords      PayrollRecord[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("Employees")
  @@unique([restaurantId, documentId])
  @@index([restaurantId, role])
}

// 3. TABLE: Orders (ID, RestaurantID, Total, MétodoPago)
model Order {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  employeeId          String?
  employee            Employee?          @relation("EmployeeOrders", fields: [employeeId], references: [id])
  
  tableId             String?
  table               RestaurantTable?   @relation(fields: [tableId], references: [id])
  
  orderNumber         String             // "CAM-8012"
  orderType           OrderType          @default(DINE_IN)
  status              OrderStatus        @default(RECEIVED)
  
  // Financial Totals in COP
  subtotalCop         Decimal            @db.Decimal(12, 2)
  impoconsumoCop      Decimal            @db.Decimal(12, 2) // 8% Impoconsumo
  tipCop              Decimal            @default(0.00) @db.Decimal(12, 2) // 10% Propina voluntaria
  discountCop         Decimal            @default(0.00) @db.Decimal(12, 2)
  deliveryFeeCop      Decimal            @default(0.00) @db.Decimal(12, 2)
  total               Decimal            @db.Decimal(12, 2) // Total en Pesos Colombianos
  
  // Local Payment Gateway
  paymentMethod       PaymentMethod      @default(NEQUI) // NEQUI | DAVIPLATA | PSE | CARD | CASH
  paymentStatus       PaymentStatus      @default(PENDING)
  wompiTransactionId  String?            // Ref Wompi Colombia e.g. "WOMPI-1724..."
  
  // DIAN Electronic Invoice & CUFE
  dianCufe            String?            // "4a8b9c0d1e2f3a4b..."
  electronicInvoiceNo String?            // "SETP-9012"
  
  // Customer Info
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  deliveryAddress     String?
  
  items               OrderItem[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("Orders")
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

// 4. TABLE: OrderItems (Comandas Detalladas)
model OrderItem {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  menuItemId          String
  menuItem            MenuItem           @relation(fields: [menuItemId], references: [id])
  
  quantity            Int                @default(1)
  unitPriceCop        Decimal            @db.Decimal(12, 2)
  totalPriceCop       Decimal            @db.Decimal(12, 2)
  notes               String?
  optionsJson         Json?

  @@map("OrderItems")
  @@index([orderId])
}

// 5. TABLE: Inventory (Stock de Ingredientes por Restaurante)
model InventoryItem {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name                String             // "Lomo Fino Angus", "Queso Paipa"
  sku                 String             // "SKU-CAR-01"
  category            String             // "carnes" | "vinos" | "lacteos" | "vegetales"
  currentStock        Float
  minStockAlert       Float              // Punto de reorden
  unit                String             // "kg", "litro", "botella", "unidad"
  costPerUnitCop      Decimal            @db.Decimal(12, 2)
  lastRestockedAt     DateTime           @default(now())

  @@map("InventoryItems")
  @@index([restaurantId, category])
}

// 6. TABLE: PayrollRecords (Liquidación de Nómina Colombia)
model PayrollRecord {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  employeeId          String
  employee            Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  periodMonth         String             // "Agosto 2026"
  baseSalaryCop       Decimal            @db.Decimal(12, 2)
  workedDays          Int                @default(30)
  overtimeHours       Int                @default(0)
  overtimePayCop      Decimal            @default(0.00) @db.Decimal(12, 2)
  transportAllowance  Decimal            @default(200000.00) @db.Decimal(12, 2) // Auxilio de Transporte
  healthDeductionCop  Decimal            @db.Decimal(12, 2) // 4% Salud
  pensionDeductionCop Decimal            @db.Decimal(12, 2) // 4% Pensión
  tipsShareCop        Decimal            @default(0.00) @db.Decimal(12, 2)
  netPayableCop       Decimal            @db.Decimal(12, 2)
  paymentStatus       String             @default("pending") // "pending" | "paid"
  paidAt              DateTime?

  createdAt           DateTime           @default(now())

  @@map("PayrollRecords")
  @@index([restaurantId, employeeId])
}

// 7. TABLE: MenuCategories & MenuItems
model MenuCategory {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  name                String             // "Cortes de Autor", "Cava de Vinos"
  icon                String             @default("Utensils")
  sortOrder           Int                @default(0)
  items               MenuItem[]

  @@map("MenuCategories")
  @@index([restaurantId])
}

model MenuItem {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  categoryId          String
  category            MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  name                String
  description         String
  priceCop            Decimal            @db.Decimal(12, 2)
  image               String
  prepTimeMinutes     Int                @default(15)
  isAvailable         Boolean            @default(true)
  isChefSpecial       Boolean            @default(false)
  dietaryTags         String[]
  
  orderItems          OrderItem[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("MenuItems")
  @@index([restaurantId, categoryId])
}

// 8. TABLE: RestaurantTables (Salón y Salones VIP)
model RestaurantTable {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  number              String             // "M-01", "M-02"
  zone                String             // "Salón Principal", "Terraza Fogata", "Cava VIP"
  capacity            Int                @default(4)
  status              TableStatus        @default(AVAILABLE)
  
  assignedEmployeeId  String?
  assignedEmployee    Employee?          @relation(fields: [assignedEmployeeId], references: [id])
  
  orders              Order[]

  @@map("RestaurantTables")
  @@unique([restaurantId, number])
  @@index([restaurantId, status])
}

// 9. TABLE: TableReservations (Reservas con Google Calendar Sync)
model TableReservation {
  id                  String             @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  reservationCode     String             // "RES-9012"
  guestName           String
  guestPhone          String
  guestEmail          String
  guestsCount         Int
  date                DateTime
  timeSlot            String             // "20:00"
  status              String             @default("confirmed")
  googleCalendarEvtId String?
  specialNotes        String?

  createdAt           DateTime           @default(now())

  @@map("TableReservations")
  @@index([restaurantId, date])
}
