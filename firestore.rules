rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Menu items: public read, write allowed for restaurant management
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: public create and read, updates for status progression
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.total is number && request.resource.data.total >= 0;
      allow update: if true;
      allow delete: if false;
    }

    // Table Reservations: public create and read, update for status change
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if request.resource.data.guestName is string;
      allow update: if true;
      allow delete: if false;
    }

    // Reviews: public read, create allowed
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // Restaurant configuration
    match /restaurant_config/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
