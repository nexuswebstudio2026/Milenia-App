rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSameRestaurant(restaurantId) {
      return isSignedIn() && (
        (request.auth.token.restaurantId != null && request.auth.token.restaurantId == restaurantId) ||
        (hasUserDoc() && getUserData().restaurantId == restaurantId)
      );
    }

    function isOwner() {
      return isSignedIn() && (
        (request.auth.token.role != null && request.auth.token.role == 'owner') ||
        (hasUserDoc() && getUserData().role == 'owner')
      );
    }

    // 1. User Profiles Collection: /users/{userId}
    match /users/{userId} {
      allow read, write: if true;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // 2. Sales & Revenue Data: /sales/{saleId}
    match /sales/{saleId} {
      allow read, write: if true;
    }

    match /sales/{saleId}/{document=**} {
      allow read, write: if true;
    }

    // 3. Attendance & Shift Logs: /attendance/{attendanceId}
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId}/{document=**} {
      allow read, write: if true;
    }

    // 4. Orders: /orders/{orderId}
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /orders/{orderId}/{document=**} {
      allow read, write: if true;
    }

    // 5. Menu Items: /menu_items/{itemId}
    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    match /menu_items/{itemId}/{document=**} {
      allow read, write: if true;
    }

    // 6. Table Reservations: /reservations/{reservationId}
    match /reservations/{reservationId} {
      allow read, write: if true;
    }

    match /reservations/{reservationId}/{document=**} {
      allow read, write: if true;
    }

    // 7. Restaurant Configuration
    match /restaurant_config/{docId} {
      allow read, write: if true;
    }

    match /restaurant_config/{docId}/{document=**} {
      allow read, write: if true;
    }

    // 8. Aliados / Tenants Directory & Subcollections (e.g., /aliados/{aliadoId}/usuarios/{userId})
    match /aliados/{aliadoId} {
      allow read, write: if true;
    }

    match /aliados/{aliadoId}/{document=**} {
      allow read, write: if true;
    }

    // 9. Contabilidad y Finanzas Milenia
    match /contabilidad/{transactionId} {
      allow read, write: if true;
    }

    match /contabilidad/{document=**} {
      allow read, write: if true;
    }

    // 10. Configuración del Sistema Milenia
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // 11. Perfil del Negocio Milenia & Pagos QR / Breve
    match /negocio/{docId} {
      allow read, write: if true;
    }

    match /negocio/{document=**} {
      allow read, write: if true;
    }

    // 12. Resumen Financiero Consolidado (Ingresos, Gastos, Balance Neto)
    match /resumen_financiero/{docId} {
      allow read, write: if true;
    }

    match /resumen_financiero/{document=**} {
      allow read, write: if true;
    }

    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    match /tenants/{tenantId}/{document=**} {
      allow read, write: if true;
    }
  }
}
