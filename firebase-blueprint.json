{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuario multi-tenant con rol (owner o staff), restaurantId y documentId",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "staff"] },
        "restaurantId": { "type": "string", "maxLength": 50 },
        "documentId": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "position": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["role", "restaurantId", "documentId", "name", "email"]
    },
    "SaleRecord": {
      "title": "SaleRecord",
      "description": "Registro de venta y facturación DIAN para métricas del restaurante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string", "maxLength": 50 },
        "orderId": { "type": "string", "maxLength": 50 },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "dianResolution": { "type": "string", "maxLength": 100 },
        "subtotalCop": { "type": "number" },
        "impoconsumoCop": { "type": "number" },
        "tipCop": { "type": "number" },
        "totalCop": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["efectivo", "nequi", "daviplata", "tarjeta", "pse", "wompi"] },
        "cashierEmployeeId": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["restaurantId", "totalCop", "paymentMethod", "createdAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Registro de asistencia, turnos de entrada y salida de empleados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string", "maxLength": 50 },
        "employeeId": { "type": "string", "maxLength": 50 },
        "employeeName": { "type": "string", "maxLength": 100 },
        "documentId": { "type": "string", "maxLength": 50 },
        "clockInTime": { "type": "string" },
        "clockOutTime": { "type": "string" },
        "totalHours": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "date": { "type": "string", "maxLength": 20 }
      },
      "required": ["restaurantId", "employeeId", "clockInTime", "status", "date"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Plato gastronómico o bebida del menú del restaurante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "nameEn": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "categoryId": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 1000 },
        "inStock": { "type": "boolean" },
        "prepTimeMinutes": { "type": "number" }
      },
      "required": ["name", "price", "categoryId", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Pedido de cliente en salón, mesa o a domicilio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string", "maxLength": 50 },
        "orderNumber": { "type": "string", "maxLength": 30 },
        "orderType": { "type": "string", "enum": ["delivery", "pickup", "dinein"] },
        "status": { "type": "string", "enum": ["received", "confirmed", "preparing", "ready", "out_for_delivery", "delivered", "cancelled"] },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "tip": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "tableNumber": { "type": "string" },
        "cashierId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["restaurantId", "orderNumber", "orderType", "status", "total", "items", "createdAt"]
    },
    "TableReservation": {
      "title": "TableReservation",
      "description": "Reserva de mesa en el restaurante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string", "maxLength": 50 },
        "reservationCode": { "type": "string", "maxLength": 20 },
        "guestName": { "type": "string", "maxLength": 100 },
        "guestEmail": { "type": "string", "maxLength": 100 },
        "guestPhone": { "type": "string", "maxLength": 30 },
        "guestsCount": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["confirmed", "seated", "completed", "cancelled"] },
        "tableAssigned": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["reservationCode", "guestName", "guestsCount", "date", "time", "status"]
    },
    "RestaurantConfig": {
      "title": "RestaurantConfig",
      "description": "Configuración global operativa del restaurante",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "restaurantId": { "type": "string", "maxLength": 50 },
        "acceptingOrders": { "type": "boolean" },
        "dianResolution": { "type": "string", "maxLength": 150 },
        "taxRate": { "type": "number" }
      },
      "required": ["name", "acceptingOrders"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Perfiles de usuarios con roles y restaurantId asignado"
    },
    "/sales/{saleId}": {
      "schema": "SaleRecord",
      "description": "Ventas y métricas de facturación aisladas por restaurante"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Registros de asistencia y turnos de empleados"
    },
    "/menu_items/{itemId}": {
      "schema": "MenuItem",
      "description": "Platos de la carta gastronómica"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Pedidos tramitados por comensales y meseros"
    },
    "/reservations/{reservationId}": {
      "schema": "TableReservation",
      "description": "Reservas de mesas en el restaurante"
    },
    "/restaurant_config/{docId}": {
      "schema": "RestaurantConfig",
      "description": "Configuración general del restaurante"
    }
  }
}
